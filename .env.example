# RepoTransBench 环境变量配置
# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交到仓库）
#
# 配置加载优先级：
#   手动 export 的环境变量 > .env 文件 > 以下默认值
#
# 注意：llm_config.yaml 已不再使用，所有配置通过环境变量或 .env 设置

# DeepSeek API（必填：DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 中转 API（可选，用于 test.py 测试脚本）
# YIZHAN_API_KEY=your-yizhan-api-key-here
